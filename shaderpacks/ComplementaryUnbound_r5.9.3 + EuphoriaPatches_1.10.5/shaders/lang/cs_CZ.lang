value.POM_DISTANCE.256=256 §e[*]
value.POM_DISTANCE.512=512 §e[*]
value.POM_DISTANCE.1024=1024 §e[*]

option.POM_LIGHTING_MODE=Režim osvětlení MPO
option.POM_LIGHTING_MODE.comment=Upravuje styl osvětlení povrchů ovlivněných MPO. Ostrý: Stěny MPO nedostanou světlo, pokud nejsou obráceny ke světlu. Hladký: Stěny MPO pořád dostanou světlo, jako by nebyly stěny. §e[*]§r Toto nastavení je vynuceno na "Hladký", pokud je kvalita MPO nastavena na méně než 100.
value.POM_LIGHTING_MODE.1=Hladký
value.POM_LIGHTING_MODE.2=Ostrý

option.POM_ALLOW_CUTOUT=§eMPO na "vyřezaných" texturách §c[-]§r
option.POM_ALLOW_CUTOUT.comment=Umožňuje, aby MPO fungovalo na "vyřezaných" částech bloků (jako třeba mezery listů). §c[-]§r Tento efekt může mít vážný dopad na výkon.

option.DIRECTIONAL_BLOCKLIGHT=§eSměrové světlo bloků§r
option.DIRECTIONAL_BLOCKLIGHT.comment=Přidává hloubku k světlu bloků v závislosi na normále povrchu. §c[-]§r Může v některých situacích způsobit vizuální artefakty. §c[-]§r Tento efekt může mít dopad na výkon. §e[*]§r Podpora textur musí být nastavena na labPBR/seuspbr a musí být použit kompatibilní balíček modifikací.
value.DIRECTIONAL_BLOCKLIGHT.0=VYP
value.DIRECTIONAL_BLOCKLIGHT.3=Jemné §c[-]
value.DIRECTIONAL_BLOCKLIGHT.7=Normální §c[-]
value.DIRECTIONAL_BLOCKLIGHT.11=Intenzivní §c[-]

option.HELD_LIGHTING_MODE=Dynamické světlo v ruce
option.HELD_LIGHTING_MODE.comment=Umožňuje zdrojům světla, aby vyplňovaly prostředí světlem, když je držíš v ruce.
value.HELD_LIGHTING_MODE.0=VYP
value.HELD_LIGHTING_MODE.1=Jemné
value.HELD_LIGHTING_MODE.2=Normální

option.BLOCKLIGHT_FLICKERING=Blikání světla bloků
option.BLOCKLIGHT_FLICKERING.comment=Přidává efekt blikání k světlu vydávanému bloky.
value.BLOCKLIGHT_FLICKERING.0=VYP

option.WAVING_SPEED=Rychlost vlání
option.WAVING_SPEED.comment=Upravuje, jak rychle se dějí efekty vlání.

option.WAVING_I=Intenzita vlání
option.WAVING_I.comment=Upravuje, jak moc se bloky hýbají, když vlají. §c[-]§r Moc vysoké hodnoty mohou způsobit, že se vlající bloky budou překrývat s jinými bloky.
value.WAVING_I.1.25=1.25 §c[-]
value.WAVING_I.1.50=1.50 §c[-]
value.WAVING_I.1.75=1.75 §c[-]
